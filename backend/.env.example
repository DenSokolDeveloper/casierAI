PORT=3000
MONGO_URI=mongodb://localhost:27017/casierai

# Secret used to sign JWTs - set a long random value in production
JWT_SECRET=dev-secret-change-me

# Bootstrap owner account, created automatically on first run if no users exist yet
OWNER_EMAIL=owner@casierai.local
OWNER_PASSWORD=

# Required for POST /api/recognize (Claude Haiku 5.5 vision product matching)
ANTHROPIC_API_KEY=

# Comma-separated list of frontend origins allowed to call this API. Required.
CORS_ORIGINS=http://localhost:4200,https://casier-ai.vercel.app
